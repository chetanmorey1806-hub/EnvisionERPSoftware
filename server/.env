# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=envision_erp
DB_CONNECTION_LIMIT=10

# ===== JWT =====
JWT_SECRET=change_this_super_secret_key_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ===== Mail (optional - leave blank to disable) =====
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Envision ERP <no-reply@envision.local>"

# ===== Uploads =====
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
